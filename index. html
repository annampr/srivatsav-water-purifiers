  <!-- JAVASCRIPT APP LOGIC -->
  <script>
    // State Variables
    let customers = [];
    let activeFilter = 'all';
    let activeLogCustomerId = null;
    let deferredPrompt = null;

    // Load Data on Initialization
    window.addEventListener('DOMContentLoaded', () => {
      loadStorageData();
      setDefaultDates();
      renderCustomerList();
      updateDashboardStats();
      checkNotificationPermission();
      registerServiceWorker();
    });

    // PWA Install Event Handler
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      document.getElementById('pwaInstallBtn').classList.remove('hidden');
    });

    function installPWA() {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(() => {
          deferredPrompt = null;
          document.getElementById('pwaInstallBtn').classList.add('hidden');
        });
      }
    }

    // Load from LocalStorage
    function loadStorageData() {
      const data = localStorage.getItem('srivatsav_purifiers_data');
      if (data) {
        try {
          customers = JSON.parse(data);
        } catch (e) {
          console.error('Failed to parse local storage', e);
          customers = [];
        }
      } else {
        // Seed initial sample record if empty
        customers = [
          {
            id: 'cust_' + Date.now(),
            name: 'K. Venkatesh',
            phone: '9849012345',
            area: 'Hanamkonda',
            purifierType: 'RO + UV',
            intervalMonths: 3,
            lastServiceDate: getOffsetDateString(-95), // Overdue by ~5 days
            nextDueDate: getOffsetDateString(-5),
            notes: 'Installed Pre-Filter and changed Spun Cartridge.',
            logs: [
              { date: new Date().toLocaleDateString('en-IN'), text: 'Initial record created' }
            ]
          }
        ];
        saveToStorage();
      }
    }

    function saveToStorage() {
      localStorage.setItem('srivatsav_purifiers_data', JSON.stringify(customers));
      updateDashboardStats();
    }

    function dismissWarning() {
      document.getElementById('warningBanner').classList.add('hidden');
    }

    // Helper Date Functions
    function formatDate(dateStr) {
      if (!dateStr) return 'N/A';
      const parts = dateStr.split('-');
      if (parts.length !== 3) return dateStr;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function getOffsetDateString(daysOffset) {
      const d = new Date();
      d.setDate(d.getDate() + daysOffset);
      return d.toISOString().split('T')[0];
    }

    function calculateNextDueDate(startDateStr, intervalMonths) {
      if (!startDateStr) return '';
      const d = new Date(startDateStr);
      d.setMonth(d.getMonth() + parseInt(intervalMonths));
      return d.toISOString().split('T')[0];
    }

    function setDefaultDates() {
      const todayStr = new Date().toISOString().split('T')[0];
      const lastServiceInput = document.getElementById('custLastServiceDate');
      if (!lastServiceInput.value) {
        lastServiceInput.value = todayStr;
      }
      recalculateNextDate();
    }

    function recalculateNextDate() {
      const lastDate = document.getElementById('custLastServiceDate').value;
      const interval = document.getElementById('custInterval').value;
      const nextDate = calculateNextDueDate(lastDate, interval);
      document.getElementById('custNextDueDate').value = nextDate;
    }

    // Navigation Logic
    function switchTab(tab) {
      ['customers', 'add', 'backup'].forEach(t => {
        document.getElementById(`view-${t}`).classList.add('hidden');
        
        // Desktop nav
        const desktopBtn = document.getElementById(`tabNav-${t}`);
        if (desktopBtn) {
          desktopBtn.classList.remove('border-cyan-500', 'text-cyan-400');
          desktopBtn.classList.add('border-transparent', 'text-slate-400');
        }

        // Mobile nav
        const mobBtn = document.getElementById(`mobNav-${t}`);
        if (mobBtn) {
          mobBtn.classList.remove('text-cyan-400');
          mobBtn.classList.add('text-slate-400');
        }
      });

      // Highlight active
      document.getElementById(`view-${tab}`).classList.remove('hidden');

      const activeDesk = document.getElementById(`tabNav-${tab}`);
      if (activeDesk) {
        activeDesk.classList.add('border-cyan-500', 'text-cyan-400');
        activeDesk.classList.remove('border-transparent', 'text-slate-400');
      }

      const activeMob = document.getElementById(`mobNav-${tab}`);
      if (activeMob) {
        activeMob.classList.add('text-cyan-400');
        activeMob.classList.remove('text-slate-400');
      }

      if (tab === 'customers') {
        renderCustomerList();
      }
    }

    // Search & Filter Handler
    function setFilter(filterKey) {
      activeFilter = filterKey;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('bg-cyan-600', 'text-white');
        btn.classList.add('bg-slate-700', 'text-slate-300');
      });

      const activeBtn = document.getElementById(`filter-${filterKey}`);
      if (activeBtn) {
        activeBtn.classList.remove('bg-slate-700', 'text-slate-300');
        activeBtn.classList.add('bg-cyan-600', 'text-white');
      }

      renderCustomerList();
    }

    function clearSearch() {
      document.getElementById('searchInput').value = '';
      document.getElementById('clearSearchBtn').classList.add('hidden');
      renderCustomerList();
    }

    // Get Status of Customer (Overdue, Today, Upcoming, Fresh)
    function getCustomerStatus(nextDueDateStr) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const due = new Date(nextDueDateStr);
      due.setHours(0, 0, 0, 0);

      const diffDays = Math.round((due - today) / (1000 * 60 * 60 * 24));

      if (diffDays < 0) {
        return { type: 'overdue', days: Math.abs(diffDays), badgeClass: 'bg-red-500/20 text-red-400 border-red-500/40', text: `Overdue by ${Math.abs(diffDays)} days` };
      } else if (diffDays === 0) {
        return { type: 'today', days: 0, badgeClass: 'bg-amber-500/20 text-amber-300 border-amber-500/40', text: 'Service Due Today!' };
      } else if (diffDays <= 30) {
        return { type: 'upcoming', days: diffDays, badgeClass: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40', text: `Due in ${diffDays} days` };
      } else {
        return { type: 'fresh', days: diffDays, badgeClass: 'bg-slate-700 text-slate-300 border-slate-600', text: `Due in ${diffDays} days` };
      }
    }

    // Render Customer Directory List
    function renderCustomerList() {
      const searchVal = (document.getElementById('searchInput').value || '').toLowerCase();
      document.getElementById('clearSearchBtn').classList.toggle('hidden', searchVal === '');

      const container = document.getElementById('customerCardsContainer');
      const emptyState = document.getElementById('emptyState');
      container.innerHTML = '';

      let filtered = customers.filter(c => {
        const matchesSearch = c.name.toLowerCase().includes(searchVal) ||
                              c.phone.includes(searchVal) ||
                              (c.area && c.area.toLowerCase().includes(searchVal));
        
        if (!matchesSearch) return false;

        const status = getCustomerStatus(c.nextDueDate);
        if (activeFilter === 'overdue') return status.type === 'overdue';
        if (activeFilter === 'today') return status.type === 'today';
        if (activeFilter === 'upcoming') return status.type === 'upcoming' || status.type === 'today';
        if (activeFilter === 'fresh') return status.type === 'fresh';

        return true;
      });

      // Sort: Overdue first, then Due Today, then chronologically
      filtered.sort((a, b) => new Date(a.nextDueDate) - new Date(b.nextDueDate));

      if (filtered.length === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
        filtered.forEach(cust => {
          const status = getCustomerStatus(cust.nextDueDate);
          
          const card = document.createElement('div');
          card.className = `bg-slate-800/90 border rounded-2xl p-4 shadow-md transition space-y-3 ${
            status.type === 'overdue' ? 'border-red-500/40' : status.type === 'today' ? 'border-amber-500/40' : 'border-slate-700/70'
          }`;

          card.innerHTML = `
            <div class="flex items-start justify-between">
              <div>
                <h3 class="font-bold text-slate-100 text-base leading-snug flex items-center space-x-2">
                  <span>${escapeHTML(cust.name)}</span>
                </h3>
                <div class="text-xs text-slate-400 mt-0.5 flex items-center space-x-2">
                  <span><i class="fa-solid fa-location-dot text-slate-500 mr-1"></i>${escapeHTML(cust.area || 'N/A')}</span>
                  <span>•</span>
                  <span><i class="fa-solid fa-filter text-slate-500 mr-1"></i>${escapeHTML(cust.purifierType || 'RO')}</span>
                </div>
              </div>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full border ${status.badgeClass} shrink-0">
                ${status.text}
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2 text-xs bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
              <div>
                <span class="text-slate-400 block text-[10px]">LAST SERVICE</span>
                <span class="font-medium text-slate-200">${formatDate(cust.lastServiceDate)}</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px]">NEXT DUE DATE</span>
                <span class="font-bold text-cyan-400">${formatDate(cust.nextDueDate)}</span>
              </div>
            </div>

            ${cust.notes ? `<p class="text-xs text-slate-400 italic bg-slate-900/30 px-2.5 py-1.5 rounded-lg border border-slate-800/50"><i class="fa-solid fa-quote-left mr-1 text-[10px] text-slate-500"></i>${escapeHTML(cust.notes)}</p>` : ''}

            <!-- Quick Action Buttons -->
            <div class="pt-1 flex items-center justify-between gap-2 text-xs border-t border-slate-700/50">
              <a href="tel:${cust.phone}" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2 px-3 rounded-xl flex items-center justify-center space-x-1.5 shadow">
                <i class="fa-solid fa-phone"></i>
                <span>Call</span>
              </a>

              <button onclick="quickRenewService('${cust.id}')" class="flex-1 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold py-2 px-3 rounded-xl flex items-center justify-center space-x-1.5 shadow">
                <i class="fa-solid fa-rotate-right"></i>
                <span>Service Done</span>
              </button>

              <button onclick="openServiceLogModal('${cust.id}')" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-2 rounded-xl flex items-center space-x-1" title="Service Logs">
                <i class="fa-solid fa-clipboard-list"></i>
                <span class="text-[10px] bg-slate-800 px-1.5 py-0.5 rounded-full font-bold ml-1 text-cyan-400">${cust.logs ? cust.logs.length : 0}</span>
              </button>

              <button onclick="editCustomer('${cust.id}')" class="bg-slate-700 hover:bg-slate-600 text-slate-300 p-2 rounded-xl" title="Edit">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>

              <button onclick="deleteCustomer('${cust.id}')" class="bg-slate-700 hover:bg-red-600/80 text-red-300 hover:text-white p-2 rounded-xl" title="Delete">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          `;

          container.appendChild(card);
        });
      }
    }

    // Save or Edit Customer Record
    function saveCustomer(e) {
      e.preventDefault();
      const id = document.getElementById('customerId').value;
      const name = document.getElementById('custName').value.trim();
      const phone = document.getElementById('custPhone').value.trim();
      const area = document.getElementById('custArea').value.trim();
      const purifierType = document.getElementById('custPurifierType').value;
      const intervalMonths = parseInt(document.getElementById('custInterval').value);
      const lastServiceDate = document.getElementById('custLastServiceDate').value;
      const nextDueDate = document.getElementById('custNextDueDate').value;
      const notes = document.getElementById('custNotes').value.trim();

      if (id) {
        // Edit existing
        const index = customers.findIndex(c => c.id === id);
        if (index !== -1) {
          customers[index] = {
            ...customers[index],
            name, phone, area, purifierType, intervalMonths, lastServiceDate, nextDueDate, notes
          };
        }
      } else {
        // Add new
        const newCust = {
          id: 'cust_' + Date.now(),
          name, phone, area, purifierType, intervalMonths, lastServiceDate, nextDueDate, notes,
          logs: [
            { date: new Date().toLocaleDateString('en-IN'), text: 'Customer account registered.' }
          ]
        };
        customers.push(newCust);
      }

      saveToStorage();
      resetCustomerForm();
      switchTab('customers');
    }

    function resetCustomerForm() {
      document.getElementById('customerForm').reset();
      document.getElementById('customerId').value = '';
      document.getElementById('formTitle').innerHTML = `<i class="fa-solid fa-user-plus text-cyan-400"></i><span>Add New Customer</span>`;
      setDefaultDates();
    }

    function editCustomer(id) {
      const cust = customers.find(c => c.id === id);
      if (!cust) return;

      document.getElementById('customerId').value = cust.id;
      document.getElementById('custName').value = cust.name;
      document.getElementById('custPhone').value = cust.phone;
      document.getElementById('custArea').value = cust.area || '';
      document.getElementById('custPurifierType').value = cust.purifierType || 'RO System';
      document.getElementById('custInterval').value = cust.intervalMonths || 3;
      document.getElementById('custLastServiceDate').value = cust.lastServiceDate;
      document.getElementById('custNextDueDate').value = cust.nextDueDate;
      document.getElementById('custNotes').value = cust.notes || '';

      document.getElementById('formTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-cyan-400"></i><span>Edit Customer Record</span>`;
      switchTab('add');
    }

    function deleteCustomer(id) {
      const cust = customers.find(c => c.id === id);
      if (confirm(`Are you sure you want to delete ${cust ? cust.name : 'this record'}?`)) {
        customers = customers.filter(c => c.id !== id);
        saveToStorage();
        renderCustomerList();
      }
    }

    // Quick Renew Service Action
    function quickRenewService(id) {
      const cust = customers.find(c => c.id === id);
      if (!cust) return;

      const todayStr = new Date().toISOString().split('T')[0];
      const nextDueDateStr = calculateNextDueDate(todayStr, cust.intervalMonths || 3);

      cust.lastServiceDate = todayStr;
      cust.nextDueDate = nextDueDateStr;
      
      if (!cust.logs) cust.logs = [];
      cust.logs.unshift({
        date: new Date().toLocaleDateString('en-IN'),
        text: `Service marked completed. Next due date updated to ${formatDate(nextDueDateStr)}.`
      });

      saveToStorage();
      renderCustomerList();
    }

    // Service & Call Log Modal
    function openServiceLogModal(id) {
      const cust = customers.find(c => c.id === id);
      if (!cust) return;

      activeLogCustomerId = id;
      document.getElementById('modalCustName').innerText = cust.name;
      document.getElementById('modalCustMeta').innerText = `${cust.phone} • ${cust.area || 'N/A'}`;
      document.getElementById('newLogText').value = '';

      renderLogHistory(cust);
      document.getElementById('serviceLogModal').classList.remove('hidden');
    }

    function closeServiceLogModal() {
      activeLogCustomerId = null;
      document.getElementById('serviceLogModal').classList.add('hidden');
    }

    function renderLogHistory(cust) {
      const container = document.getElementById('logHistoryContainer');
      container.innerHTML = '';

      const logs = cust.logs || [];
      if (logs.length === 0) {
        container.innerHTML = `<p class="text-slate-500 italic">No interaction notes added yet.</p>`;
        return;
      }

      logs.forEach(log => {
        const item = document.createElement('div');
        item.className = 'bg-slate-900 border border-slate-800 p-2.5 rounded-lg space-y-1';
        item.innerHTML = `
          <div class="text-[10px] text-cyan-400 font-semibold">${escapeHTML(log.date)}</div>
          <div class="text-slate-200">${escapeHTML(log.text)}</div>
        `;
        container.appendChild(item);
      });
    }

    function saveLogEntry() {
      if (!activeLogCustomerId) return;
      const text = document.getElementById('newLogText').value.trim();
      if (!text) return;

      const cust = customers.find(c => c.id === activeLogCustomerId);
      if (!cust) return;

      if (!cust.logs) cust.logs = [];
      cust.logs.unshift({
        date: new Date().toLocaleDateString('en-IN') + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        text: text
      });

      saveToStorage();
      renderLogHistory(cust);
      renderCustomerList();
      document.getElementById('newLogText').value = '';
    }

    // Update Top Dashboard Statistics
    function updateDashboardStats() {
      let overdue = 0;
      let today = 0;
      let upcoming = 0;

      customers.forEach(c => {
        const status = getCustomerStatus(c.nextDueDate);
        if (status.type === 'overdue') overdue++;
        if (status.type === 'today') today++;
        if (status.days >= 0 && status.days <= 7) upcoming++;
      });

      document.getElementById('statTotal').innerText = customers.length;
      document.getElementById('statOverdue').innerText = overdue;
      document.getElementById('statToday').innerText = today;
      document.getElementById('statUpcoming').innerText = upcoming;

      // Update Filter Counter Badges
      document.getElementById('cnt-all').innerText = customers.length;
      document.getElementById('cnt-overdue').innerText = overdue;
      document.getElementById('cnt-today').innerText = today;

      const upcoming30 = customers.filter(c => {
        const st = getCustomerStatus(c.nextDueDate);
        return st.type === 'upcoming' || st.type === 'today';
      }).length;
      document.getElementById('cnt-upcoming').innerText = upcoming30;

      const freshCount = customers.filter(c => getCustomerStatus(c.nextDueDate).type === 'fresh').length;
      document.getElementById('cnt-fresh').innerText = freshCount;
    }

    // Export & Import Backup Engines
    function exportJSONBackup() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(customers, null, 2));
      const downloadAnchor = document.createElement('a');
      const filename = `SRIVATSAV_Purifiers_Backup_${new Date().toISOString().split('T')[0]}.json`;
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", filename);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function exportCSV() {
      if (customers.length === 0) {
        alert("No records to export.");
        return;
      }

      let csvContent = "data:text/csv;charset=utf-8,";
      csvContent += "Customer Name,Phone,Location,Purifier Model,Last Service Date,Next Follow-up Due,Notes\n";

      customers.forEach(c => {
        const row = [
          `"${c.name.replace(/"/g, '""')}"`,
          `"${c.phone}"`,
          `"${(c.area || '').replace(/"/g, '""')}"`,
          `"${(c.purifierType || '').replace(/"/g, '""')}"`,
          `"${c.lastServiceDate}"`,
          `"${c.nextDueDate}"`,
          `"${(c.notes || '').replace(/"/g, '""')}"`
        ];
        csvContent += row.join(",") + "\n";
      });

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `SRIVATSAV_Customers_${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      link.remove();
    }

    function importJSONBackup() {
      const fileInput = document.getElementById('importFile');
      if (!fileInput.files || fileInput.files.length === 0) {
        alert("Please select a JSON backup file first.");
        return;
      }

      const file = fileInput.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const importedData = JSON.parse(e.target.result);
          if (Array.isArray(importedData)) {
            if (confirm(`Restore ${importedData.length} records? Existing records will be merged.`)) {
              // Merge records preserving unique IDs
              const existingIds = new Set(customers.map(c => c.id));
              importedData.forEach(item => {
                if (!existingIds.has(item.id)) {
                  customers.push(item);
                }
              });
              saveToStorage();
              renderCustomerList();
              alert("Data restored successfully!");
              switchTab('customers');
            }
          } else {
            alert("Invalid backup file format.");
          }
        } catch (err) {
          alert("Error reading file. Ensure it is a valid JSON backup.");
        }
      };
      reader.readAsText(file);
    }

    // Helper Utility: Escape HTML
    function escapeHTML(str) {
      if (!str) return '';
      return str.replace(/[&<>'"]/g, 
        tag => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag)
      );
    }

    // Web Notifications Handler
    function checkNotificationPermission() {
      if ('Notification' in window && Notification.permission === 'default') {
        document.getElementById('notificationBanner').classList.remove('hidden');
      }
    }

    function requestNotificationPermission() {
      if ('Notification' in window) {
        Notification.requestPermission().then(permission => {
          document.getElementById('notificationBanner').classList.add('hidden');
          if (permission === 'granted') {
            triggerDueNotification();
          }
        });
      }
    }

    function triggerDueNotification() {
      const overdueOrToday = customers.filter(c => {
        const st = getCustomerStatus(c.nextDueDate);
        return st.type === 'overdue' || st.type === 'today';
      });

      if (overdueOrToday.length > 0 && Notification.permission === 'granted') {
        new Notification('SRIVATSAV Water Purifiers', {
          body: `You have ${overdueOrToday.length} customer service(s) due or overdue today!`,
          icon: 'https://img.icons8.com/color/192/water-filter.png'
        });
      }
    }

    // Inline Service Worker Registration for Offline Capabilities
    function registerServiceWorker() {
      if ('serviceWorker' in navigator) {
        const swCode = `
          const CACHE_NAME = 'srivatsav-tracker-v1';
          self.addEventListener('install', e => {
            e.waitUntil(
              caches.open(CACHE_NAME).then(cache => {
                return cache.addAll(['./']);
              })
            );
          });
          self.addEventListener('fetch', e => {
            e.respondWith(
              caches.match(e.request).then(response => {
                return response || fetch(e.request);
              })
            );
          });
        `;
        const blob = new Blob([swCode], { type: 'application/javascript' });
        const blobUrl = URL.createObjectURL(blob);
        navigator.serviceWorker.register(blobUrl).catch(err => console.log('SW Registration failed', err));
      }
    }
  </script>
